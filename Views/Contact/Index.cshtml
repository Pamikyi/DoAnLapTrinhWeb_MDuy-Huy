@model DoAnLapTrinhWebBanThucAnNhanh.Models.Contact

<div class="container mt-5">
    <h2 class="mb-4">📩 Liên hệ</h2>

    <form asp-action="Contact" method="post" class="card p-4 shadow-sm">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Họ và tên</label>
            <input asp-for="Fullname" class="form-control" />
            <span asp-validation-for="Fullname" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Nội dung</label>
            <textarea asp-for="MessageContent" rows="5"
                      class="form-control"></textarea>
            <span asp-validation-for="MessageContent" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Gửi liên hệ
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
