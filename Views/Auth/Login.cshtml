<h2 class="text-center my-4">Đăng nhập</h2>

<form asp-action="Login" asp-controller="Auth" method="post" class="mx-auto" style="max-width: 400px;">
    <div class="mb-3">
        <label class="form-label">Tên đăng nhập</label>
        <input type="text" name="username" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Mật khẩu</label>
        <input type="password" name="password" class="form-control" />
    </div>

    <button class="btn btn-primary w-100">Đăng nhập</button>

    @if (TempData["Error"] != null)
    {
        <p class="text-danger text-center mt-2">@TempData["Error"]</p>
    }

    <div class="text-center mt-3">
        <a asp-controller="Auth" asp-action="Register">Chưa có tài khoản? Đăng ký ngay</a>
    </div>
</form>
