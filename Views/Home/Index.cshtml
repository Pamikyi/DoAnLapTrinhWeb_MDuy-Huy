@model DoAnLapTrinhWebBanThucAnNhanh.Models.HomeIndexViewModel

<!-- Main Content -->
<div class="container-fluid px-4 py-3">
  <div class="row g-1">
    <!-- Left Sidebar -->
    <div class="col-lg-2 col-md-3">
      <!-- Toast theo dõi đơn hàng (demo) -->
      <div class="toast show mt-1" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
          <strong class="me-auto">Đơn hàng sắp giao !</strong>
          <button type="button" class="btn-close ms-2 mb-1" data-bs-dismiss="toast" aria-label="Close">
            <span aria-hidden="true"></span>
          </button>
        </div>
        <small class="p-2">11 mins ago</small>
        <div class="toast-body">
          Đơn hàng của bạn sắp tới vui lòng chú ý điện thoại
        </div>
      </div>

      <div class="toast show mt-1" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header">
          <strong class="me-auto">Đơn hàng sắp giao !</strong>
          <button type="button" class="btn-close ms-2 mb-1" data-bs-dismiss="toast" aria-label="Close">
            <span aria-hidden="true"></span>
          </button>
        </div>
        <small class="p-2">11 mins ago</small>
        <div class="toast-body">
          Đơn hàng của bạn sắp tới vui lòng chú ý điện thoại
        </div>
      </div>
    </div>

    <!-- Center Content -->
    <div class="col-lg-8 col-md-6">
      <!-- Banner Carousel -->
      <div id="bannerCarousel" class="carousel slide mb-3" data-bs-ride="carousel">
        <div class="carousel-inner">
          <div class="carousel-item active">
            <div class="banner-slide">
              <img
                src="https://d3design.vn/uploads/Anh_Bia_Food_menu_web_banner_social_media_banner_template_Free_Psd.jpg"
                class="card-img-top img-fluid" style="max-height: 180px; object-fit: cover" alt="Banner chính" />
            </div>
          </div>

          <div class="carousel-item">
            <div class="banner-slide">
              <img src="https://cdn2.fptshop.com.vn/unsafe/Uploads/images/tin-tuc/176808/Originals/poster-do-an-14.jpg"
                class="card-img-top img-fluid" style="max-height: 180px; object-fit: cover" alt="Banner phụ" />
            </div>
          </div>

          <div class="carousel-item">
            <div class="banner-slide">
              <img src="https://cdn2.fptshop.com.vn/unsafe/Uploads/images/tin-tuc/176808/Originals/poster-do-an-20.jpg"
                class="card-img-top img-fluid" style="max-height: 180px; object-fit: cover" alt="Banner phụ" />
            </div>
          </div>
        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>

      <!-- Bán Chạy -->
      <div class="container py-4">
        <h3 class="mb-3 text-primary">Cháy hàng bà con ơi</h3>

        <div class="product-row">
          @foreach (var p in Model.BanChay)
          {
            <div class="card product-card shadow-sm">
              <img src="@p.ImageURL" class="card-img-top" alt="@p.ProductName" />
              <div class="card-body d-flex flex-column justify-content-between">
                <div>
                  <h5 class="card-title mb-1">@p.ProductName</h5>
                  <p class="card-text text-muted small mb-2">@p.Descriptions</p>
                  <p class="fw-bold text-danger mb-3">@p.Price.ToString("N0") ₫</p>
                </div>
                <div class="d-flex gap-1">
                  <a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductID"
                    class="btn btn-outline-primary flex-fill text-truncate">
                    Chi tiết
                  </a>
                  <a asp-controller="Cart" asp-action="Add" asp-route-id="@p.ProductID"
                    class="btn btn-primary flex-fill text-truncate">
                    Thêm vào giỏ
                  </a>
                </div>
              </div>
            </div>
          }
        </div>
      </div>

      <!-- Món Mới -->
      <div class="container py-4">
        <h3 class="mb-3 text-primary">Món mới</h3>

        <div class="product-row">
          @foreach (var p in Model.MonMoi)
          {
            <div class="card product-card shadow-sm">
              <img src="@p.ImageURL" class="card-img-top" alt="@p.ProductName" />
              <div class="card-body d-flex flex-column justify-content-between">
                <div>
                  <h5 class="card-title mb-1">@p.ProductName</h5>
                  <p class="card-text text-muted small mb-2">@p.Descriptions</p>
                  <p class="fw-bold text-danger mb-3">@p.Price.ToString("N0") ₫</p>
                </div>
                <div class="btn-group-custom mt-auto">
                  <a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductID"
                    class="btn btn-outline-primary flex-fill">
                    Chi tiết
                  </a>
                  <a asp-controller="Cart" asp-action="Add" asp-route-id="@p.ProductID" class="btn btn-primary flex-fill">
                    Thêm vào giỏ
                  </a>
                </div>
              </div>
            </div>
          }
        </div>
      </div>

      <!-- Món Tuổi Thơ -->
      <div class="container py-4">
        <h3 class="mb-3 text-primary">Món tuổi thơ</h3>

        <div class="product-row">
          @foreach (var p in Model.MonTuoiTho)
          {
            <div class="card product-card shadow-sm">
              <img src="@p.ImageURL" class="card-img-top" alt="@p.ProductName" />
              <div class="card-body d-flex flex-column justify-content-between">
                <div>
                  <h5 class="card-title mb-1">@p.ProductName</h5>
                  <p class="card-text text-muted small mb-2">@p.Descriptions</p>
                  <p class="fw-bold text-danger mb-3">@p.Price.ToString("N0") ₫</p>
                </div>
                <div class="btn-group-custom mt-auto">
                  <a asp-controller="Products" asp-action="Details" asp-route-id="@p.ProductID"
                    class="btn btn-outline-primary flex-fill">
                    Chi tiết
                  </a>
                  <a asp-controller="Cart" asp-action="Add" asp-route-id="@p.ProductID" class="btn btn-primary flex-fill">
                    Thêm vào giỏ
                  </a>
                </div>
              </div>
            </div>
          }
        </div>
      </div>
    </div>

    <!-- Right Sidebar -->
    <div class="col-lg-2 col-md-3">
      <div class="sidebar-content d-flex justify-content-center">
        <div class="ad-area d-flex flex-column gap-3">
          <img
            src="https://cdn2.fptshop.com.vn/unsafe/1920x0/filters:format(webp):quality(75)/2024_2_24_638444073567684080_anh-dai-dien.jpg"
            class="img-fluid rounded" alt="Quảng cáo" />
          <img src="https://insieutoc.vn/wp-content/uploads/2021/03/mau-poster-dep.jpg" class="img-fluid rounded"
            alt="Quảng cáo" />
          <img src="https://insieutoc.vn/wp-content/uploads/2021/03/poster-dep.jpg" class="img-fluid rounded"
            alt="Quảng cáo" />
          <img src="https://insieutoc.vn/wp-content/uploads/2021/03/cac-mau-poster-dep.jpg" class="img-fluid rounded"
            alt="Quảng cáo" />
        </div>
      </div>
    </div>
    @if (TempData["CheckoutSuccess"] != null)
{
    <div class="toast-container position-fixed top-0 end-0 p-3">

        <div id="checkoutToast"
             class="toast text-bg-success border-0"
             role="alert"
             aria-live="assertive"
             aria-atomic="true">

            <div class="d-flex">
                <div class="toast-body">
                    @TempData["CheckoutSuccess"]
                </div>
                <button type="button"
                        class="btn-close btn-close-white me-2 m-auto"
                        data-bs-dismiss="toast">
                </button>
            </div>

        </div>

    </div>

    <script>
        window.addEventListener("load", function () {
            const toastEl = document.getElementById('checkoutToast');
            const toast = new bootstrap.Toast(toastEl, {
                delay: 2000
            });
            toast.show();
        });
    </script>
}
  </div>
</div>