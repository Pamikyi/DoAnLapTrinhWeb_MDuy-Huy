@model DoAnLapTrinhWebBanThucAnNhanh.Models.ViewModels.DashboardViewModel
<h2>Dashboard</h2>
<div class="row g-3 mt-3">
    <!-- Sẩn phẩm -->
    <div class="col-md-3">
        <div class="card p-3 bg-primary text-white shadow-sm">
            <h3>
                @Model.TotalProducts
            </h3>
            <p>Sản phẩm</p>
        </div>
    </div>
    <!-- DON HANG -->
    <div class="col-md-3">
        <div class="card p-3 bg-success text-white shadow-sm">
            <h3>
                @Model.TotalOrders
            </h3>
            <p>Đơn hàng</p>
        </div>
    </div>
    <!-- NGU?I DUNG -->
    <div class="col-md-3">
        <div class="card p-3 bg-warning text-white shadow-sm">
            <h3>
                @Model.TotalUsers
            </h3>
            <p>Người dùng </p>
        </div>
    </div>
    <!-- DOANH THU -->
    <div class="col-md-3">
        <div class="card p-3 bg-danger text-white shadow-sm">
            <h4>
                @Model.TotalRevenue.ToString("N0") đồng
            </h4>
            <p>Doanh thu</p>
        </div>
    </div>
</div>
<div class="card mt-4 p-3 shadow-sm">
    <h5>Biểu đồ doanh thu theo tháng</h5>
    <canvas id="chartRevenue"></canvas>
</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const ctx = document.getElementById("chartRevenue");

        new Chart(ctx, {
            type: "line",
            data: {
                labels:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Labels)),
                datasets: [{
                    label: "Doanh thu (VND)",
                    data:@Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Data)),
                    borderWidth: 2,
                    borderColor: "rgba(75, 192, 192, 1)",
                    backgroundColor: "rgba(75, 192, 192, 0.2)",
                    tension: 0.3
                }]
            }
        });
    </script>
}