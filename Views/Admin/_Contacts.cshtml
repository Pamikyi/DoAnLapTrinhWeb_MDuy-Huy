@model List<DoAnLapTrinhWebBanThucAnNhanh.Models.Contact>

<div id="contacts" class="page" style="display:none;">

    <h2>Liên hệ khách hàng</h2>

    <div class="card shadow-sm mt-3">
        <div class="card-header bg-primary text-white">
            <h5 class="m-0">Danh sách liên hệ</h5>
        </div>

        <div class="card-body p-0">

            <table class="table table-bordered table-hover m-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Nội dung</th>
                        <th>Ngày gửi</th>
                        <th width="120">Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td>@c.ContactID</td>
                            <td>@c.Fullname</td>
                            <td>@c.Email</td>
                            <td>@c.MessageContent</td>
                            <td>@c.CreateAt.ToString("dd/MM/yyyy")</td>

                            <td class="text-center">
                                <a href="/Contacts/Details/@c.ContactID"
                                   class="btn btn-primary btn-sm">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a href="/Contacts/Delete/@c.ContactID"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Xoá liên hệ này?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
