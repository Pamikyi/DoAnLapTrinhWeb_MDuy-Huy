@model List<DoAnLapTrinhWebBanThucAnNhanh.Models.Category>

<div id="categories" class="page" style="display:none;">

    <h2>Danh mục sản phẩm</h2>

    <a href="/Categories/Create" class="btn btn-primary mb-3">
        <i class="bi bi-plus-lg"></i> Thêm danh mục
    </a>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="m-0">Danh sách danh mục</h5>
        </div>

        <div class="card-body p-0">
            <table class="table table-bordered table-hover m-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Tên danh mục</th>
                        <th width="120">Hành động</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td>@cat.CategoryID</td>
                            <td>@cat.CategoryName</td>

                            <td class="text-center">
                                <a href="/Categories/Edit/@cat.CategoryID" class="btn btn-warning btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                <a href="/Categories/Delete/@cat.CategoryID"
                                   class="btn btn-danger btn-sm"
                                   onclick="return confirm('Xoá danh mục này?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    </div>

</div>
