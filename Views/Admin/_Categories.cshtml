@model List<DoAnLapTrinhWebBanThucAnNhanh.Models.Category>

<h2 class="mb-3">Danh mục sản phẩm</h2>

<!-- Nút thêm (GIỮ NGUYÊN FORMAT – CHỈ ĐỔI LINK CHO ADMIN SPA NẾU CẦN) -->
<button type="button" class="btn btn-success mb-3" onclick="openCreateCategories()">
        ➕ Thêm sản phẩm
</button>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="m-0">Danh sách danh mục</h5>
    </div>

    <div class="card-body p-0">
        <table class="table table-bordered table-hover m-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Tên danh mục</th>
                    <th width="120">Hành động</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var cat in Model)
                    {
                        <tr>
                            <td>@cat.CategoryID</td>
                            <td>@cat.CategoryName</td>

                            <td class="text-center">
                                <button type="button" class="btn btn-danger btn-sm"
                                    onclick="deleteCategory(@cat.CategoryID)">
                                <i class="bi bi-trash"></i>
                            </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-3">
                            Chưa có danh mục nào
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
