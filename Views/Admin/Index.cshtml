@{
    Layout = "_AdminLayout";
}

<div class="container-fluid mt-4 mainContent">
    <!-- Nội dung SPA -->
    <div id="mainContent">
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 fw-bold">Đang tải dữ liệu...</p>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {

        // Gắn sự kiện sidebar sau khi DOM đã load
        setupSidebarEvents();

        // Tải dashboard mặc định
        loadPage("Dashboard");
    });

    // Gắn sự kiện click cho sidebar
    function setupSidebarEvents() {
        document.querySelectorAll(".sidebar .nav-link").forEach(link => {
            link.addEventListener("click", function (e) {
                e.preventDefault();
                const page = this.dataset.page;

                // Map sidebar → controller action
                const map = {
                    dashboard: "Dashboard",
                    products: "ProductList",
                    categories: "CategoryList",
                    orders: "OrderList",
                    users: "UserList",
                    contacts: "ContactList"
                };

                loadPage(map[page]);
            });
        });
    }

    // Hàm load partial qua fetch
    function loadPage(pageName) {

        // Loading spinner
        document.getElementById("mainContent").innerHTML = `
            <div class="text-center mt-5">
                <div class="spinner-border text-primary"></div>
                <p class="mt-2 fw-bold">Đang tải dữ liệu...</p>
            </div>`;

        fetch(`/Admin/${pageName}`)
            .then(res => {
                if (!res.ok) {
                    return `<div class="alert alert-danger">
                                Không thể tải trang <b>${pageName}</b>
                                (Lỗi: ${res.status})
                            </div>`;
                }
                return res.text();
            })
            .then(html => {
                document.getElementById("mainContent").innerHTML = html;

                // Update active sidebar
                document.querySelectorAll(".sidebar .nav-link")
                    .forEach(l => l.classList.remove("active"));

                const target = document.querySelector(`[data-page='${pageName.toLowerCase()}']`);
                if (target) target.classList.add("active");
            })
            .catch(err => {
                document.getElementById("mainContent").innerHTML = `
                    <div class="alert alert-danger">
                        Xảy ra lỗi khi tải trang: ${err}
                    </div>`;
            });
    }
</script>
}
