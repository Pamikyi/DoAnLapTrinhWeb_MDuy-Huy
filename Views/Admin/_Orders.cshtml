@model List<DoAnLapTrinhWebBanThucAnNhanh.Models.CustomerOrder>

<h2 class="mb-3">Quản lý Đơn hàng</h2>

<div class="card shadow-sm mt-3">
    <div class="card-header bg-primary text-white">
        <h5 class="m-0">Danh sách đơn hàng</h5>
    </div>

    <div class="card-body p-0">
        <table class="table table-bordered table-hover m-0">
            <thead class="table-dark">
                <tr>
                    <th>Mã đơn</th>
                    <th>Khách hàng</th>
                    <th>Ngày đặt</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th width="140">Hành động</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.CustomerOrdersID</td>
                            <td>@order.ReceiverName</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy")</td>
                            <td>@order.TotalAmount.ToString("N0") ₫</td>

                            <td>
                                <span class="badge bg-info">
                                    @order.Status
                                </span>
                            </td>

                            <td class="text-center">
                                <!-- VIEW DETAIL (SPA) -->
                                <button class="btn btn-primary btn-sm"
                                        onclick="openOrderDetail(@order.CustomerOrdersID)">
                                    <i class="bi bi-eye"></i>
                                </button>

                                <!-- DELETE (SPA) -->
                                <button class="btn btn-danger btn-sm"
                                        onclick="deleteOrder(@order.CustomerOrdersID)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">
                            Chưa có đơn hàng nào
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>
