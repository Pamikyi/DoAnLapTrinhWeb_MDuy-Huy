@model List<DoAnLapTrinhWebBanThucAnNhanh.Models.UserHL>

<h2 class="mb-3">Quản lý Người dùng</h2>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="m-0">Danh sách người dùng</h5>
    </div>

    <div class="card-body p-0">
        <table class="table table-bordered table-hover m-0">
            <thead class="table-dark">
                <tr>
                    <th>Số</th>
                    <th>Tài khoản</th>
                    <th>Email</th>
                    <th>Số điện thoại</th>
                    <th>Vai trò</th>
                    <th style="width: 120px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var u in Model)
                    {
                        <tr>
                            <td>@u.UserID</td>
                            <td>@u.Username</td>
                            <td>@u.Email</td>
                            <td>@u.PhoneNumber</td>
                            <td>
                                <span class="badge bg-success">
                                    @u.Role?.RoleName
                                </span>
                            </td>
                            <td class="text-center">
                                <!-- EDIT USER (SPA) -->
                                <button class="btn btn-warning btn-sm" onclick="openEditUser(@u.UserID)">
                                    <i class="bi bi-pencil"></i>
                                </button>

                                <!-- DELETE USER (SPA) -->
                                <button class="btn btn-danger btn-sm" onclick="deleteUser(@u.UserID)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-3">
                            Chưa có người dùng nào
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>