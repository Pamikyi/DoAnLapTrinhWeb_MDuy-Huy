@model List<CartItem>

<div class="container">
    <h2>Giỏ hàng của bạn</h2>

    @if (!Model.Any())
    {
        <p class="alert alert-warning mt-5">Giỏ hàng đang trống.</p>
        return;
    }

    <table class="table table-bordered mt-5">
        <thead>
            <tr>
                <th>Ảnh</th>
                <th>Sản phẩm</th>
                <th>Giá</th>
                <th>Số lượng</th>
                <th>Tổng</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <!-- IMAGE -->
                    <td>
                        <img src="@item.Image"
                             width="60"
                             class="rounded"
                             style="object-fit: cover;" />
                    </td>

                    <!-- NAME -->
                    <td>@item.Name</td>

                    <!-- PRICE -->
                    <td>@item.Price.ToString("N0") ₫</td>

                    <!-- QUANTITY -->
                    <td>
                        <input type="number"
                               min="1"
                               value="@item.Quantity"
                               onchange="updateQuantity(@item.ProductID, this.value)"
                               class="form-control form-control-sm text-center"
                               style="width: 70px;">
                    </td>

                    <!-- TOTAL -->
                    <td>
                        @((item.Price * item.Quantity).ToString("N0")) ₫
                    </td>

                    <!-- REMOVE -->
                    <td>
                        <a href="/Cart/Remove/@item.ProductID"
                           class="btn btn-danger btn-sm">
                            Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @{
        var total = Model.Sum(x => x.Price * x.Quantity);
    }

    <!-- Total + Checkout -->
    <div class="text-end mt-4">
        <h4 class="fw-bold">
            Tổng cộng:
            <span class="text-danger">@total.ToString("N0") ₫</span>
        </h4>

        <a asp-action="Checkout" class="btn btn-primary btn-lg mt-3">
            Thanh toán
        </a>
    </div>
</div>

@section Scripts {
<script>
    function updateQuantity(id, quantity) {
        window.location.href = `/Cart/UpdateQuantity?id=${id}&quantity=${quantity}`;
    }
</script>
}
