@model DoAnLapTrinhWebBanThucAnNhanh.Models.ViewModels.CheckoutViewModel

<div class="container my-5">

    <h2 class="mb-4 text-primary">Thanh toán</h2>

    <div class="row">
        <!-- FORM -->
        <div class="col-lg-7">

            <div class="card border-primary mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="m-0">Thông tin giao hàng</h5>
                </div>

                <div class="card-body">

                    <form asp-action="Checkout" method="post">

                        <div class="mb-3">
                            <label class="form-label">Họ và tên</label>
                            <input asp-for="ReceiverName" class="form-control" required />
                            <span class="text-danger" asp-validation-for="ReceiverName"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Số điện thoại</label>
                            <input asp-for="Phone" class="form-control" required />
                            <span class="text-danger" asp-validation-for="Phone"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Địa chỉ giao hàng</label>
                            <textarea asp-for="ShippingAddress" class="form-control" rows="3" required></textarea>
                            <span class="text-danger" asp-validation-for="ShippingAddress"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ghi chú (tuỳ chọn)</label>
                            <textarea asp-for="Request" class="form-control" rows="2"></textarea>
                        </div>

                        <button class="btn btn-success btn-lg px-4">
                            Xác nhận thanh toán
                        </button>

                    </form>

                </div>
            </div>
        </div>

        <!-- CART SUMMARY -->
        <div class="col-lg-5">

            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="m-0">Đơn hàng của bạn</h5>
                </div>

                <div class="card-body">

                    @foreach (var item in Model.CartItems)
                    {
                        <div class="d-flex justify-content-between mb-2">
                            <div>
                                <strong>@item.Name</strong>
                                <div class="text-muted small">x @item.Quantity</div>
                            </div>

                            <div class="fw-bold text-danger">
                                @((item.Price * item.Quantity).ToString("N0")) ₫
                            </div>
                        </div>

                        <hr />
                    }

                    <div class="d-flex justify-content-between">
                        <h5 class="fw-bold">Tổng cộng:</h5>
                        <h5 class="text-danger fw-bold">
                            @Model.TotalAmount.ToString("N0") ₫
                        </h5>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
